        "import numpy as np\n",
        "import scipy.integrate as sci\n",
        "import pandas as pd\n",
        "\n",
        "\n",
        "# PROBLEMA (a)\n",
        "\n",
        "def f_a(x):\n",
        "    return np.exp(-x**2)\n",
        "\n",
        "# Encontrar M tal que exp(-M^2) < 10^{-a}\n",
        "def encontrar_M(a):\n",
        "    M = 0\n",
        "    while True:\n",
        "        if np.exp(-M**2) < 10**(-a):\n",
        "            return M\n",
        "        M += 1\n",
        "\n",
        "# Regla del trapecio extendida en [-M, M]\n",
        "def trapecio_extendido(f, h, M):\n",
        "    xs = np.arange(-M, M+h, h)\n",
        "    ys = f(xs)\n",
        "    return h * (0.5*ys[0] + np.sum(ys[1:-1]) + 0.5*ys[-1])\n",
        "\n",
        "# Resolver problema (a)\n",
        "A = [1, 6, 10]\n",
        "H = [0.5, 0.1, 0.01]\n",
        "\n",
        "rows = []\n",
        "\n",
        "for a in A:\n",
        "    M = encontrar_M(a)\n",
        "    print(f\"a={a}, M encontrado = {M}\")\n",
        "    for h in H:\n",
        "        I_trap = trapecio_extendido(f_a, h, M)\n",
        "        I_quad = sci.quad(f_a, -np.inf, np.inf)[0]\n",
        "        err = abs(I_trap - I_quad)\n",
        "        rows.append([a, h, M, I_trap, I_quad, err])\n",
        "\n",
        "df_a = pd.DataFrame(rows, columns=[\"a\",\"h\",\"M\",\"Trapecio\",\"Quad\",\"Error\"])\n",
        "print(\"\\nRESULTADOS PROBLEMA (a)\\n\")\n",
        "print(df_a)\n",
        "\n",
        "\n",
        "\n",
        "# PROBLEMA (b)\n",
        "# I = ∫₀¹ dx / sqrt(x (e^x + 1))\n",
        "\n",
        "\n",
        "def f_b(x):\n",
        "    return 1 / np.sqrt(x*(np.exp(x)+1))\n",
        "\n",
        "# Trapecio simple en [0,1]\n",
        "def trapecio(f, a, b, n):\n",
        "    x = np.linspace(a, b, n+1)\n",
        "    y = f(x)\n",
        "    h = (b-a)/n\n",
        "    return h*(0.5*y[0] + np.sum(y[1:-1]) + 0.5*y[-1])\n",
        "\n",
        "rows_b = []\n",
        "Nvals = [100, 1000, 5000]\n",
        "\n",
        "for n in Nvals:\n",
        "    I_trap = trapecio(f_b, 0, 1, n)\n",
        "    I_quad = sci.quad(f_b, 0, 1)[0]\n",
        "    err = abs(I_trap - I_quad)\n",
        "    rows_b.append([n, I_trap, I_quad, err])\n",
        "\n",
        "df_b = pd.DataFrame(rows_b, columns=[\"n\",\"Trapecio\",\"Quad\",\"Error\"])\n",
        "\n",
        "print(\"\\nRESULTADOS PROBLEMA (b)\\n\")\n",
        "print(df_b)\n",
        "\n",
        "\n",
        "\n",
        "# PROBLEMA (c)\n",
        "# I = ∫₀¹ x^0.7 cos(x) dx\n",
        "\n",
        "\n",
        "def f_c(x):\n",
        "    return x**0.7 * np.cos(x)\n",
        "\n",
        "rows_c = []\n",
        "\n",
        "for n in Nvals:\n",
        "    I_trap = trapecio(f_c, 0, 1, n)\n",
        "    I_quad = sci.quad(f_c, 0, 1)[0]\n",
        "    err = abs(I_trap - I_quad)\n",
        "    rows_c.append([n, I_trap, I_quad, err])\n",
        "\n",
        "df_c = pd.DataFrame(rows_c, columns=[\"n\",\"Trapecio\",\"Quad\",\"Error\"])\n",
        "\n",
        "print(\"\\nRESULTADOS PROBLEMA (c)\\n\")\n",
