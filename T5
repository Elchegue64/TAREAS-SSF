        "import numpy as np\n",
        "import scipy.integrate as sci\n",
        "import pandas as pd\n",
        "\n",
        "# Métodos Numéricos\n",
        "\n",
        "def trapecio(f, a, b, n):\n",
        "    x = np.linspace(a, b, n+1)\n",
        "    y = f(x)\n",
        "    h = (b - a) / n\n",
        "    return h * (0.5*y[0] + np.sum(y[1:-1]) + 0.5*y[-1])\n",
        "\n",
        "def simpson(f, a, b, n):\n",
        "    if n % 2 == 1:\n",
        "        raise ValueError(\"Simpson requiere n par\")\n",
        "    x = np.linspace(a, b, n+1)\n",
        "    y = f(x)\n",
        "    h = (b - a) / n\n",
        "    return h/3 * (y[0] + y[-1] + 4*np.sum(y[1:-1:2]) + 2*np.sum(y[2:-2:2]))\n",
        "\n",
        "def gauss_legendre(f, a, b, n):\n",
        "    xg, wg = np.polynomial.legendre.leggauss(n)\n",
        "    xp = 0.5*(b-a)*xg + 0.5*(b+a)\n",
        "    wp = 0.5*(b-a)*wg\n",
        "    return np.sum(wp * f(xp))\n",
        "\n",
        "# Función general de comparación\n",
        "\n",
        "\n",
        "def comparar(f, a, b, ns_t, ns_s, ns_g):\n",
        "    I_ref = sci.quad(f, a, b)[0]\n",
        "    tabla = []\n",
        "\n",
        "    for n in ns_t:\n",
        "        val = trapecio(f, a, b, n)\n",
        "        tabla.append([\"Trapecio\", n, val, abs(val - I_ref)])\n",
        "\n",
        "    for n in ns_s:\n",
        "        val = simpson(f, a, b, n)\n",
        "        tabla.append([\"Simpson\", n, val, abs(val - I_ref)])\n",
        "\n",
        "    for n in ns_g:\n",
        "        val = gauss_legendre(f, a, b, n)\n",
        "        tabla.append([\"Gauss-Legendre\", n, val, abs(val - I_ref)])\n",
        "\n",
        "    return pd.DataFrame(tabla, columns=[\"Método\", \"n\", \"Integral\", \"Error\"])\n",
        "\n",
        "\n",
        "# FUNCIONES DE TU TAREA\n",
        "\n",
        "\n",
        "# 1) f(x) = (1 / (2π)) * exp(-(x^2)/2)\n",
        "def f1(x):\n",
        "    return (1/(2*np.pi))*np.exp(-(x**2)/2)\n",
        "\n",
        "# 2) f(x) = (e^x sin x) / (1+x^2)\n",
        "def f2(x):\n",
        "    return (np.exp(x) * np.sin(x)) / (1 + x**2)\n",
        "\n",
        "\n",
        "# PROBLEMA 1 — Integrar f1(x) en [-1, 1]\n",
        "\n",
        "print(\"\\n=== PROBLEMA 1: f1(x) en [-1, 1] ===\\n\")\n",
        "df1 = comparar(f1, -1, 1,\n",
        "               ns_t=[6, 16],\n",
        "               ns_s=[6, 16],\n",
        "               ns_g=[6, 16])\n",
        "print(df1)\n",
        "\n",
        "\n",
        "# PROBLEMA 2 — Integrar f1(x) en [-1, 1] con más particiones\n",
        "\n",
        "print(\"\\n=== PROBLEMA 2: f1(x) en [-1, 1] ===\\n\")\n",
        "df2 = comparar(f1, -1, 1,\n",
        "               ns_t=[6, 16, 20],\n",
        "               ns_s=[6, 16, 20],\n",
        "               ns_g=[6, 16])\n",
        "print(df2)\n",
        "\n",
        "# PROBLEMA 3 — Integrar f1(x) en [-2, 0]\n",
        "\n",
        "print(\"\\n=== PROBLEMA 3: f1(x) en [-2, 0] ===\\n\")\n",
