    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "\n",
        "#   OSCILADOR NO LINEAL x'' + k x^3 = 0\n",
        "#   Método RK4\n",
        "\n",
        "\n",
        "def f(t, x, v, k):\n",
        "    \"\"\"dv/dt = -k x^3\"\"\"\n",
        "    return -k * x**3\n",
        "\n",
        "def rk4_step(x, v, t, dt, k):\n",
        "    \"\"\"Un solo paso de RK4 para sistema x' = v, v' = f.\"\"\"\n",
        "\n",
        "    # k1\n",
        "    k1_x = v\n",
        "    k1_v = f(t, x, v, k)\n",
        "\n",
        "    # k2\n",
        "    k2_x = v + 0.5*dt*k1_v\n",
        "    k2_v = f(t + 0.5*dt, x + 0.5*dt*k1_x, v + 0.5*dt*k1_v, k)\n",
        "\n",
        "    # k3\n",
        "    k3_x = v + 0.5*dt*k2_v\n",
        "    k3_v = f(t + 0.5*dt, x + 0.5*dt*k2_x, v + 0.5*dt*k2_v, k)\n",
        "\n",
        "    # k4\n",
        "    k4_x = v + dt*k3_v\n",
        "    k4_v = f(t + dt, x + dt*k3_x, v + dt*k3_v, k)\n",
        "\n",
        "    # Actualización\n",
        "    x_new = x + (dt/6)*(k1_x + 2*k2_x + 2*k3_x + k4_x)\n",
        "    v_new = v + (dt/6)*(k1_v + 2*k2_v + 2*k3_v + k4_v)\n",
        "\n",
        "    return x_new, v_new\n",
        "\n",
        "\n",
        "def solve_nonlinear_oscillator(x0=1.0, v0=0.0, k=1.0, tmax=50, dt=0.01):\n",
        "    \"\"\"Resuelve x'' + k x^3 = 0 usando RK4.\"\"\"\n",
        "\n",
        "    N = int(tmax/dt)\n",
        "    t = np.linspace(0, tmax, N)\n",
        "\n",
        "    x = np.zeros(N)\n",
        "    v = np.zeros(N)\n",
        "\n",
        "    x[0] = x0\n",
        "    v[0] = v0\n",
        "\n",
        "    for i in range(N-1):\n",
        "        x[i+1], v[i+1] = rk4_step(x[i], v[i], t[i], dt, k)\n",
        "\n",
        "    return t, x, v\n",
        "\n",
        "# PRUEBA RÁPIDA\n",
        "\n",
        "\n",
        "t, x, v = solve_nonlinear_oscillator(x0=1.0, v0=0.0, k=1.0, tmax=40, dt=0.01)\n",
        "\n",
        "plt.figure(figsize=(10,4))\n",
        "plt.plot(t, x, label=\"x(t)\")\n",
        "plt.title(\"Oscilador No Lineal: x'' + k x^3 = 0 (RK4)\")\n",
        "plt.xlabel(\"t\")\n",
        "plt.ylabel(\"x\")\n",
        "plt.grid()\n",
        "plt.legend()\n",
        "plt.show()\n"
      ],
