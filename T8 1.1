        "import math\n",
        "import numpy as np\n",
        "from scipy.integrate import odeint\n",
        "\n",
        "def f(y, t):\n",
        "   lam = 1\n",
        "   return -lam * y + math.sin(10 * math.pi * t)\n",
        "\n",
        "ts = np.arange(0, 12.01, 0.01)\n",
        "y0 = -2\n",
        "ys = odeint(f, y0, ts)\n",
        "\n",
        "import pylab\n",
        "pylab.plot(ts, ys)\n",
        "pylab.savefig('odeintexample2.pdf')\n",
        "pylab.show()"
