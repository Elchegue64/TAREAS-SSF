        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.integrate import solve_ivp\n",
        "\n",
        "def euler(y, t, dt, derivs):\n",
        "    \"\"\"\n",
        "    Euler's method for solving ODEs\n",
        "    \"\"\"\n",
        "    return y + derivs(y, t) * dt\n",
        "\n",
        "def rk4(y, t, dt, derivs):\n",
        "    \"\"\"\n",
        "    Runge-Kutta 4th order method\n",
        "    \"\"\"\n",
        "    k1 = derivs(y, t)\n",
        "    k2 = derivs(y + 0.5 * dt * k1, t + 0.5 * dt)\n",
        "    k3 = derivs(y + 0.5 * dt * k2, t + 0.5 * dt)\n",
        "    k4 = derivs(y + dt * k3, t + dt)\n",
        "    return y + (dt / 6.0) * (k1 + 2*k2 + 2*k3 + k4)\n",
        "\n",
        "# Parameters\n",
        "N = 1000                # number of steps to take\n",
        "xo = 1.0                # initial position (changed to see oscillation better)\n",
        "vo = 0.0                # initial velocity\n",
        "tau = 5.0               # total time for the simulation, in seconds\n",
        "dt = tau/float(N-1)     # time step\n",
        "k = 3.5                 # spring constant, in N/m\n",
        "m = 0.2                 # mass, in kg\n",
        "gravity = 9.8           # g, in m/s^2\n",
        "\n",
        "def SHO(t, state):\n",
        "\n",
        "    x, v = state\n",
        "    dxdt = v\n",
        "    dvdt = -k/m * x - gravity\n",
        "    return [dxdt, dvdt]\n",
        "\n",
        "def SHO_for_euler_rk4(state, t):\n",
        "\n",
        "    x, v = state\n",
        "    dxdt = v\n",
        "    dvdt = -k/m * x - gravity\n",
        "    return np.array([dxdt, dvdt])\n",
        "\n",
        "# Time array for Euler and RK4\n",
        "time_fixed = np.linspace(0, tau, N)\n",
        "\n",
        "# Initialize arrays for different methods\n",
        "y_euler = np.zeros([N, 2])\n",
        "y_rk4 = np.zeros([N, 2])\n",
        "y_euler[0] = [xo, vo]\n",
        "y_rk4[0] = [xo, vo]\n",
        "\n",
        "# Solve using Euler method\n",
        "print(\"Solving with Euler method...\")\n",
        "for j in range(N-1):\n",
        "    y_euler[j+1] = euler(y_euler[j], time_fixed[j], dt, SHO_for_euler_rk4)\n",
        "\n",
        "# Solve using RK4 method\n",
        "print(\"Solving with RK4 method...\")\n",
        "for j in range(N-1):\n",
        "    y_rk4[j+1] = rk4(y_rk4[j], time_fixed[j], dt, SHO_for_euler_rk4)\n",
        "\n",
        "# Solve using RK45 (adaptive step size)\n",
        "print(\"Solving with RK45 method...\")\n",
        "solution_rk45 = solve_ivp(SHO, [0, tau], [xo, vo], method='RK45',\n",
        "                         rtol=1e-8, atol=1e-10, dense_output=True)\n",
        "\n",
        "# Extract data for plotting\n",
        "x_euler = y_euler[:, 0]\n",
        "v_euler = y_euler[:, 1]\n",
        "\n",
        "x_rk4 = y_rk4[:, 0]\n",
        "v_rk4 = y_rk4[:, 1]\n",
        "\n",
        "x_rk45 = solution_rk45.y[0]\n",
        "v_rk45 = solution_rk45.y[1]\n",
        "time_rk45 = solution_rk45.t\n",
        "\n",
        "# Create dense output for RK45 at fixed time points for better comparison\n",
        "x_rk45_dense = solution_rk45.sol(time_fixed)[0]\n",
        "v_rk45_dense = solution_rk45.sol(time_fixed)[1]\n",
        "\n",
        "# Calculate energy for each method\n",
        "def total_energy(x, v):\n",
        "    \"\"\"Calculate total energy: kinetic + potential\"\"\"\n",
        "    kinetic = 0.5 * m * v**2\n",
        "    potential_spring = 0.5 * k * x**2\n",
        "    potential_gravity = m * gravity * x\n",
        "    return kinetic + potential_spring + potential_gravity\n",
        "\n",
        "energy_euler = total_energy(x_euler, v_euler)\n",
        "energy_rk4 = total_energy(x_rk4, v_rk4)\n",
        "energy_rk45 = total_energy(x_rk45_dense, v_rk45_dense)\n",
        "\n",
        "# Plotting comparison\n",
        "fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n",
        "\n",
        "# Position comparison\n",
        "axes[0, 0].plot(time_fixed, x_euler, label='Euler', linewidth=1.5, alpha=0.7)\n",
        "axes[0, 0].plot(time_fixed, x_rk4, label='RK4', linewidth=1.5, alpha=0.7)\n",
        "axes[0, 0].plot(time_fixed, x_rk45_dense, label='RK45', linewidth=1.5, alpha=0.8)\n",
        "axes[0, 0].set_xlabel('Time (s)')\n",
        "axes[0, 0].set_ylabel('Position (m)')\n",
        "axes[0, 0].set_title('Position vs Time')\n",
        "axes[0, 0].legend()\n",
        "axes[0, 0].grid(True)\n",
        "\n",
        "# Velocity comparison\n",
        "axes[0, 1].plot(time_fixed, v_euler, label='Euler', linewidth=1.5, alpha=0.7)\n",
        "axes[0, 1].plot(time_fixed, v_rk4, label='RK4', linewidth=1.5, alpha=0.7)\n",
        "axes[0, 1].plot(time_fixed, v_rk45_dense, label='RK45', linewidth=1.5, alpha=0.8)\n",
        "axes[0, 1].set_xlabel('Time (s)')\n",
        "axes[0, 1].set_ylabel('Velocity (m/s)')\n",
        "axes[0, 1].set_title('Velocity vs Time')\n",
        "axes[0, 1].legend()\n",
        "axes[0, 1].grid(True)\n",
        "\n",
        "# Energy comparison\n",
        "axes[1, 0].plot(time_fixed, energy_euler, label='Euler', linewidth=2, alpha=0.8)\n",
        "axes[1, 0].plot(time_fixed, energy_rk4, label='RK4', linewidth=2, alpha=0.8)\n",
        "axes[1, 0].plot(time_fixed, energy_rk45, label='RK45', linewidth=2, alpha=0.8)\n",
        "axes[1, 0].set_xlabel('Time (s)')\n",
        "axes[1, 0].set_ylabel('Total Energy (J)')\n",
        "axes[1, 0].set_title('Total Energy Conservation')\n",
        "axes[1, 0].legend()\n",
        "axes[1, 0].grid(True)\n",
        "\n",
        "# Error comparison (using RK45 as reference)\n",
        "error_euler = np.abs(x_euler - x_rk45_dense)\n",
        "error_rk4 = np.abs(x_rk4 - x_rk45_dense)\n",
        "\n",
        "axes[1, 1].semilogy(time_fixed, error_euler, label='Euler Error', linewidth=2, alpha=0.8)\n",
        "axes[1, 1].semilogy(time_fixed, error_rk4, label='RK4 Error', linewidth=2, alpha=0.8)\n",
        "axes[1, 1].set_xlabel('Time (s)')\n",
        "axes[1, 1].set_ylabel('Absolute Error (m)')\n",
