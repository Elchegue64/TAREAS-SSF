        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.gridspec import GridSpec\n",
        "\n",
        "def runge_kutta_4(f, tspan, y0, n, args=()):\n",
        "    \"\"\"\n",
        "    SOLUCIONADOR DE ECUACIONES DIFERENCIALES - Runge-Kutta 4to orden\n",
        "    \"\"\"\n",
        "    t0, tf = tspan\n",
        "    h = (tf - t0) / n\n",
        "    t = np.linspace(t0, tf, n+1)\n",
        "    y = np.zeros((n+1, len(y0)))\n",
        "    y[0] = y0\n",
        "\n",
        "    for i in range(n):\n",
        "        k1 = h * f(t[i], y[i], *args)\n",
        "        k2 = h * f(t[i] + h/2, y[i] + k1/2, *args)\n",
        "        k3 = h * f(t[i] + h/2, y[i] + k2/2, *args)\n",
        "        k4 = h * f(t[i] + h, y[i] + k3, *args)\n",
        "        y[i+1] = y[i] + (k1 + 2*k2 + 2*k3 + k4)/6\n",
        "\n",
        "    return t, y\n",
        "\n",
        "def fuerza_oscilador_con_friccion(t, y, p, k, m, F0, omega_drive, gamma):\n",
        "\n",
        "    x, v = y\n",
        "\n",
        "    # Fuerza restauradora no lineal\n",
        "    if p == 2:\n",
        "        F_rest = -k * x\n",
        "    else:\n",
        "        F_rest = -k * np.abs(x)**(p-1) * np.sign(x)\n",
        "\n",
        "    # Fuerza externa sinusoidal\n",
        "    F_ext = F0 * np.sin(omega_drive * t)\n",
        "\n",
        "    # Fuerza de fricción viscosa (proporcional a la velocidad)\n",
        "    F_fric = -gamma * v\n",
        "\n",
        "    # Aceleración total\n",
        "    a = (F_rest + F_ext + F_fric) / m\n",
        "\n",
        "    return np.array([v, a])\n",
        "\n",
        "# PUNTO 7: EXPLORAR RESONANCIA EN SISTEMAS NO LINEALES\n",
