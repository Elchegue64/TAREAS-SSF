        "import numpy as np\n",
        "import pandas as pd\n",
        "import math\n",
        "\n",
        "\n",
        "#   PARTE (b)\n",
        "#   Evaluación de cos(x) por:\n",
        "#   i) Serie directa\n",
        "#   ii) Cómputo parcial (incremental)\n",
        "#   Se generan tablas con:\n",
        "#   x, iteración, suma, error_relativo\n",
        "\n",
        "\n",
        "\n",
        "# 1. cos serie directa\n",
        "\n",
        "def cos_series_direct(x, tol):\n",
        "    \"\"\"\n",
        "    Evalúa cos(x) usando la definición directa de la serie:\n",
        "        sum_{k=0}^\\infty (-1)^k x^{2k}/(2k)!\n",
        "    Detiene cuando el último término < tol.\n",
        "    Regresa lista de pasos.\n",
        "    \"\"\"\n",
        "    steps = []\n",
        "    k = 0\n",
        "    term = 1.0\n",
        "    s = term\n",
        "    true_val = math.cos(x)\n",
        "\n",
        "    steps.append([k, s, abs(s - true_val)/abs(true_val) if true_val != 0 else float('inf')])\n",
        "\n",
        "    while abs(term) > tol:\n",
        "        k += 1\n",
        "        term = ((-1)**k) * (x**(2*k)) / math.factorial(2*k)\n",
        "        s += term\n",
        "        err_rel = abs(s - true_val)/abs(true_val) if true_val != 0 else float('inf')\n",
        "        steps.append([k, s, err_rel])\n",
        "\n",
        "    return steps\n",
        "\n",
        "# 2. cos computación parcial incremental\n",
        "#    Cada término se obtiene del anterior:\n",
        "#\n",
        "#    a_0 = 1\n",
        "#    a_{k+1} = -a_k * x^2 / ((2k+1)*(2k+2))\n",
        "\n",
        "def cos_series_partial(x, tol):\n",
        "    steps = []\n",
        "    k = 0\n",
        "    term = 1.0\n",
        "    s = term\n",
        "    true_val = math.cos(x)\n",
        "\n",
        "    steps.append([k, s, abs(s - true_val)/abs(true_val) if true_val != 0 else float('inf')])\n",
        "\n",
        "    while abs(term) > tol:\n",
        "        k += 1\n",
        "        term *= -(x**2)/((2*k-1)*(2*k))\n",
        "        s += term\n",
        "        err_rel = abs(s - true_val)/abs(true_val) if true_val != 0 else float('inf')\n",
        "        steps.append([k, s, err_rel])\n",
        "\n",
        "    return steps\n",
        "\n",
        "# Función para generar tablas como DataFrame\n",
        "\n",
        "def make_table(x, steps):\n",
        "    df = pd.DataFrame(steps, columns=[\"iteración\", \"suma\", \"error_relativo\"])\n",
        "    df.insert(0, \"x\", x)\n",
        "    return df\n",
        "\n",
        "# Ejecutar la comparación para varias x y tolerancias\n",
        "\n",
        "xs = [1e-6, 1e-3, 0.1, 1, 10, 100]\n",
        "tolerancias = [1e-4, 1e-8]\n",
        "\n",
        "resultados_direct = {}\n",
        "resultados_partial = {}\n",
        "\n",
        "for x in xs:\n",
        "    resultados_direct[x] = {}\n",
        "    resultados_partial[x] = {}\n",
        "    for tol in tolerancias:\n",
        "        steps_d = cos_series_direct(x, tol)\n",
        "        steps_p = cos_series_partial(x, tol)\n",
        "\n",
        "        resultados_direct[x][tol] = make_table(x, steps_d)\n",
        "        resultados_partial[x][tol] = make_table(x, steps_p)\n",
        "\n",
        "# Mostrar resultado organizado\n",
        "\n",
        "print(\"        RESULTADOS PARTE (b)\")\n",
        "\n",
        "for x in xs:\n",
        "    for tol in tolerancias:\n",
        "        print(f\" MÉTODO: SERIE DIRECTA  |  x = {x}  tol = {tol}\")\n",
        "\n",
        "        display(resultados_direct[x][tol])\n",
        "\n",
        "        print(f\" MÉTODO: COMPUTACIÓN PARCIAL  |  x = {x}  tol = {tol}\")\n",
        "\n",
        "        display(resultados_partial[x][tol])\n",
        "\n",
        "# la serie no converge ni con 1e-4, por error de redondeo.\n"
