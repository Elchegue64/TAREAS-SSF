        "import time\n",
        "import random\n",
        "import numpy as np\n",
        "\n",
        "\n",
        "#   VARIANTES PARA EVALUAR POLINOMIOS\n",
        "#   según Bendersky + derivación de Mamber\n",
        "\n",
        "\n",
        "\n",
        "# 1. Naive — O(n^2)\n",
        "\n",
        "def poly_naive(A, x):\n",
        "    p = 0\n",
        "    for i, a in enumerate(A):\n",
        "        p += (x**i) * a\n",
        "    return p\n",
        "\n",
        "# 2. Iterativa — O(n)\n",
        "#    Variante inducida (strong induction en Mamber)\n",
        "#    Mantiene x^n-1, luego x^n\n",
        "\n",
        "def poly_iter(A, x):\n",
        "    p = 0\n",
        "    xn = 1\n",
        "    for a in A:\n",
        "        p += a * xn\n",
        "        xn *= x\n",
        "    return p\n",
        "\n",
        "# 3. Horner – O(n)\n",
        "#    Forma clásica, como en Bendersky\n",
        "\n",
        "def poly_horner(A, x):\n",
        "    p = A[-1]\n",
        "    for i in range(len(A)-2, -1, -1):\n",
        "        p = p*x + A[i]\n",
        "    return p\n",
        "\n",
        "# 4. Mamber – Inducción fuerte (strong hypothesis)\n",
        "#    Similar al iterativo, pero explícitamente siguiendo\n",
        "#    la estructura inductiva donde se guarda x^(n-1)\n",
        "\n",
        "def poly_mamber_strong(A, x):\n",
        "    # base case\n",
        "    if len(A) == 1:\n",
        "        return A[0]\n",
        "\n",
        "    # inductive step:\n",
        "\n",
        "    P_prev = 0\n",
        "    xn_prev = 1\n",
        "\n",
        "    for i in range(len(A)-1):\n",
        "        P_prev += A[i] * xn_prev\n",
        "        xn_prev *= x\n",
        "\n",
        "    # ahora extendemos al caso n\n",
        "    return P_prev + A[-1] * xn_prev\n",
        "\n",
        "\n",
        "# 5. Mamber – Reverse induction\n",
        "\n",
        "def poly_mamber_reverse(A, x):\n",
        "    # base case: P_0(x) = a0\n",
        "    p = A[-1]\n",
        "    # inductive extension P_n(x) = x * P_{n-1}(x) + a0\n",
        "    for i in range(len(A)-2, -1, -1):\n",
        "        p = x*p + A[i]\n",
        "    return p\n",
        "\n",
        "\n",
        "\n",
        "#   PRUEBAS DE CORRECCIÓN\n",
        "\n",
        "\n",
        "def test_polynomial_functions():\n",
        "    tests = [\n",
        "        ([5, -1, 2, 3], 2),   # 5 -2 + 8 + 24 = 35\n",
        "        ([1, 0, 0, 0, 2], 3), # 1 + 2*3^4\n",
        "        ([random.uniform(-1,1) for _ in range(10)], 0.5),\n",
        "        ([random.uniform(-1,1) for _ in range(50)], 1.7),\n",
        "    ]\n",
        "\n",
        "    funcs = [\n",
        "        poly_naive,\n",
        "        poly_iter,\n",
        "        poly_horner,\n",
        "        poly_mamber_strong,\n",
        "        poly_mamber_reverse\n",
        "    ]\n",
        "\n",
        "    for A, x in tests:\n",
        "        print(f\"\\n--- Test con x={x} grado={len(A)-1} ---\")\n",
        "        values = [f(A, x) for f in funcs]\n",
        "        for name, val in zip([\"Naive\", \"Iter\", \"Horner\", \"Mamber strong\", \"Mamber reverse\"], values):\n",
        "            print(name.ljust(15), val)\n",
        "        print(\"¿Coinciden todos?:\", all(abs(values[i]-values[0]) < 1e-9 for i in range(len(values))))\n",
        "\n",
        "\n",
        "\n",
        "#   COMPARACIÓN DE TIEMPOS\n",
        "\n",
        "\n",
        "def time_function(f, A, x, repeats=2000):\n",
        "    t0 = time.time()\n",
        "    for _ in range(repeats):\n",
        "        f(A, x)\n",
        "    return time.time() - t0\n",
        "\n",
        "def benchmark():\n",
        "    print(\"\\n=============== BENCHMARK ===============\")\n",
        "    A = [random.uniform(-1,1) for _ in range(500)]\n",
        "    x = 1.2\n",
        "    funcs = [\n",
        "        (\"Naive\", poly_naive),\n",
        "        (\"Iter\", poly_iter),\n",
        "        (\"Horner\", poly_horner),\n",
        "        (\"Mamber strong\", poly_mamber_strong),\n",
        "        (\"Mamber reverse\", poly_mamber_reverse),\n",
        "    ]\n",
        "    for name, f in funcs:\n",
        "        t = time_function(f, A, x)\n",
        "        print(name.ljust(15), f\"{t:.6f} s\")\n",
        "\n",
        "\n",
        "\n",
        "#   CORRER PRUEBAS\n",
        "\n",
        "\n",
        "test_polynomial_functions()\n",
        "benchmark()\n"
      ]
