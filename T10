        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "np.random.seed(12345)\n",
        "\n",
        "# Parámetros\n",
        "a, b = 5.0, 10.0\n",
        "n = 100     # alumnos por curso\n",
        "n_rep = 10  # cursos\n",
        "\n",
        "# Teoría (continuo uniforme)\n",
        "mu = 0.5*(a+b)\n",
        "var = (b-a)**2 / 12.0\n",
        "sd = np.sqrt(var)\n",
        "var_mean = var / n\n",
        "sd_mean = np.sqrt(var_mean)\n",
        "\n",
        "print(\"Distribución U(5,10):\")\n",
        "print(f\"  Media teórica: {mu:.6f}\")\n",
        "print(f\"  Varianza poblacional: {var:.6f}\")\n",
        "print(f\"  Desviación estándar poblacional: {sd:.6f}\")\n",
        "print(f\"\\nPara n={n}:\")\n",
        "print(f\"  Varianza del promedio (theoretical): {var_mean:.6f}\")\n",
        "print(f\"  Desviación estándar del promedio (theoretical): {sd_mean:.6f}\")\n",
        "\n",
        "# Simulación: generar 10 cursos\n",
        "promedios = []\n",
        "varianzas = []\n",
        "for i in range(n_rep):\n",
        "    notas = np.random.uniform(a, b, size=n)\n",
        "    promedios.append(notas.mean())\n",
        "    varianzas.append(notas.var(ddof=0))  # var poblacional (ddof=0). Si quieres var muestral usa ddof=1.\n",
        "\n",
        "# Convertir a array\n",
        "promedios = np.array(promedios)\n",
        "varianzas = np.array(varianzas)\n",
        "\n",
        "# Resultados por curso\n",
        "df = pd.DataFrame({\n",
        "    \"curso\": np.arange(1, n_rep+1),\n",
        "    \"promedio\": promedios,\n",
        "    \"varianza\": varianzas,\n",
        "    \"desv_std\": np.sqrt(varianzas)\n",
        "})\n",
        "print(\"\\nResultados por curso (10 cursos):\")\n",
        "print(df.to_string(index=False, float_format='{:.6f}'.format))\n",
        "\n",
        "# Estadísticas sobre los 10 cursos\n",
        "mean_of_means = promedios.mean()\n",
        "std_of_means = promedios.std(ddof=1)   # desviación muestral entre los 10 promedios\n",
        "mean_of_vars = varianzas.mean()\n",
        "std_of_vars = varianzas.std(ddof=1)\n",
        "\n",
        "print(\"\\nEstadísticas sobre los 10 cursos:\")\n",
        "print(f\"  Promedio de los promedios: {mean_of_means:.6f}\")\n",
        "print(f\"  Desviación estándar de los promedios (muestral, n_rep-1): {std_of_means:.6f}\")\n",
        "print(f\"  Promedio de las varianzas de curso: {mean_of_vars:.6f}\")\n",
        "print(f\"  Desviación estándar de las varianzas (muestral): {std_of_vars:.6f}\")\n",
        "\n",
        "# Comparación con teoría:\n",
        "print(\"\\nComparación con teoría:\")\n",
        "print(f\"  Media teórica del promedio: {mu:.6f}\")\n",
        "print(f\"  Desviación teórica del promedio: {sd_mean:.6f}\")\n",
        "\n",
        "# Si quieres ver histograma de promedios y de varianzas (opcional):\n",
        "import matplotlib.pyplot as plt\n",
        "plt.figure(figsize=(10,4))\n",
        "plt.subplot(1,2,1)\n",
        "plt.hist(promedios, bins=6, edgecolor='k')\n",
        "plt.axvline(mu, color='r', linestyle='--', label='mu theor.')\n",
        "plt.title('Histograma de promedios (10 cursos)')\n",
        "plt.legend()\n",
        "plt.subplot(1,2,2)\n",
        "plt.hist(varianzas, bins=6, edgecolor='k')\n",
        "plt.axvline(var, color='r', linestyle='--', label='var poblacional')\n",
        "plt.title('Histograma de varianzas (10 cursos)')\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
